{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stock Quest integration events v1",
  "description": "At-least-once delivery; inbox deduplicates eventId; per-aggregate monotonic version. No credentials or direct contact fields. User IDs require access control and retention policies.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "const": "SimulacionFinalizada"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "const": "simulacion-logistica"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "aggregateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "data": {
          "type": "object",
          "properties": {
            "simulationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "userId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "scenarioId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "profit": {
              "type": "number"
            },
            "serviceRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "completedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "simulationId",
            "userId",
            "scenarioId",
            "score",
            "profit",
            "serviceRate",
            "completedAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "eventId",
        "type",
        "schemaVersion",
        "producer",
        "occurredAt",
        "aggregateId",
        "aggregateVersion",
        "correlationId",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "const": "LeccionCompletada"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "const": "aprendizaje-evaluacion"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "aggregateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "data": {
          "type": "object",
          "properties": {
            "userId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "lessonId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "moduleId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "completedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "userId",
            "lessonId",
            "moduleId",
            "completedAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "eventId",
        "type",
        "schemaVersion",
        "producer",
        "occurredAt",
        "aggregateId",
        "aggregateVersion",
        "correlationId",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "const": "DesafioRespondido"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "const": "aprendizaje-evaluacion"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "aggregateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "data": {
          "type": "object",
          "properties": {
            "attemptId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "userId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "challengeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "lessonId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "moduleId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "score": {
              "type": "integer",
              "enum": [
                0,
                100
              ]
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "attemptId",
            "userId",
            "challengeId",
            "lessonId",
            "moduleId",
            "score",
            "createdAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "eventId",
        "type",
        "schemaVersion",
        "producer",
        "occurredAt",
        "aggregateId",
        "aggregateVersion",
        "correlationId",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "const": "ProgresoActualizado"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "const": "aprendizaje-evaluacion"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "aggregateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "data": {
          "type": "object",
          "properties": {
            "userId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "progress": {
              "$ref": "#/$defs/Progress"
            },
            "activities": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/Activity"
              }
            }
          },
          "required": [
            "userId",
            "progress",
            "activities"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "eventId",
        "type",
        "schemaVersion",
        "producer",
        "occurredAt",
        "aggregateId",
        "aggregateVersion",
        "correlationId",
        "data"
      ],
      "additionalProperties": false,
      "description": "Implemented full report snapshot. aggregateVersion is the independent projection sequence for this user, not the learning fact sequence. Immutable eventId/version; idempotent replay; older snapshots never regress a projection."
    },
    {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "const": "MiembroAsignado"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "const": "personas-capacitacion"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "aggregateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "data": {
          "type": "object",
          "properties": {
            "groupId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "userId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "leaderId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "groupId",
            "userId",
            "leaderId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "eventId",
        "type",
        "schemaVersion",
        "producer",
        "occurredAt",
        "aggregateId",
        "aggregateVersion",
        "correlationId",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "const": "MiembroRetirado"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "const": "personas-capacitacion"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "aggregateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "data": {
          "type": "object",
          "properties": {
            "groupId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "userId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "leaderId": {
              "type": "string",
