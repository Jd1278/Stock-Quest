    {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "const": "UsuarioDesactivado"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "const": "personas-capacitacion"
        },
