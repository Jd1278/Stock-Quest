        "data"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "Progress": {
      "type": "object",
      "properties": {
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "simulations": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "boolean"
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Topic"
          }
        },
        "achievements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Achievement"
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "completed",
        "total",
        "percent",
        "xp",
        "level",
        "simulations",
        "passed",
        "topics",
        "achievements",
        "recommendations"
      ]
    },
    "Topic": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "needsReview": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "completed",
        "total",
        "score",
        "needsReview"
      ]
    },
    "Achievement": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "earnedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "key",
        "earnedAt"
      ]
    },
    "Activity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "answer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "challenge": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "score",
        "answer",
        "createdAt",
        "challenge"
      ],
      "additionalProperties": false
    }
  }
}
