{
  "name": "stock-quest",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "gateway"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB \"npm run dev -w @stock-quest/gateway\" \"node scripts/dev-web.cjs\"",
    "build": "npm run build -w @stock-quest/gateway && npm run build -w @stock-quest/web",
    "lint": "eslint frontend gateway --max-warnings 0",
    "test": "npm run test -w @stock-quest/gateway && npm run test -w @stock-quest/web",
    "verify:gateway": "node scripts/verify-gateway-isolation.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.25.1",
    "typescript-eslint": "^8.31.1",
    "typescript": "~5.8.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "@types/jest": "^29.5.14",
    "pg": "^8.16.3",
    "bcrypt": "^6.0.0"
  }
}
