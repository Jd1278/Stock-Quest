{
  "name": "@stock-quest/api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:check": "node scripts/check-database.mjs",
    "db:migrate:prisma": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "6.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "prisma": "6.19.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4"
  }
}
