DATABASE_URL="postgresql://stockquest:change-me@127.0.0.1:5432/stockquest"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="8h"
FRONTEND_URL="http://localhost:5173"
PORT=4000
# Choose one owner for simulation. Keep legacy until Java and both migrations are ready.
SIMULATION_BACKEND=legacy
SIMULATION_SERVICE_URL=http://127.0.0.1:4010
LEARNING_BACKEND=legacy
LEARNING_SERVICE_URL=http://127.0.0.1:4020
PEOPLE_BACKEND=legacy
PEOPLE_SERVICE_URL=http://127.0.0.1:4030
# In people java mode: learning and simulation must also be java.
# PEOPLE_JWT_SECRET belongs only to the Java identity service, never to this edge.
# In learning java mode: simulation must also be java; use a separate learning credential.
# LEARNING_SERVICE_TOKEN=
# In java mode, set both tokens (minimum 32 characters); do not use shared sample values.
# SIMULATION_SERVICE_TOKEN=
# SIMULATION_EVENT_TOKEN=
SEED_ADMIN_EMAIL="gestor@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_LEADER_EMAIL="lider@example.com"
SEED_LEADER_PASSWORD="replace-with-a-different-password"


# Render externo: agrega ?sslmode=require&connect_timeout=15&connection_limit=5
