{
  "name": "stock-quest",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "gateway"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB \"npm run dev -w @stock-quest/gateway\" \"node scripts/dev-web.cjs\"",
    "build": "npm run build -w @stock-quest/gateway && npm run build -w @stock-quest/web",
    "lint": "eslint backend frontend gateway --max-warnings 0",
    "test": "npm run test -w @stock-quest/gateway && npm run test -w @stock-quest/web",
    "db:generate": "npm run db:generate -w @stock-quest/api",
    "db:migrate": "npm run db:migrate -w @stock-quest/api",
    "db:seed": "npm run db:seed -w @stock-quest/api",
    "db:check": "npm run db:check -w @stock-quest/api --",
    "dev:legacy": "concurrently -n API,WEB \"npm run dev -w @stock-quest/api\" \"node scripts/dev-web.cjs --legacy\"",
    "build:legacy": "npm run build -w @stock-quest/api",
    "test:legacy": "npm run test -w @stock-quest/api",
    "verify:gateway": "node scripts/verify-gateway-isolation.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.25.1",
    "typescript-eslint": "^8.31.1",
    "typescript": "~5.8.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "@types/jest": "^29.5.14"
  }
}
