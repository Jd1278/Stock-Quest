# Reference only. Spring does not automatically read .env files.
PEOPLE_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/stockquest_people_dev
PEOPLE_DB_USER=stockquest_people
PEOPLE_DB_PASSWORD=replace-with-local-password
PEOPLE_PORT=4030
# At least 32 bytes; unique to Java identity. Do not share with other services.
# PEOPLE_JWT_SECRET=
PEOPLE_JWT_EXPIRES_IN=8h
LEARNING_SERVICE_URL=http://127.0.0.1:4020
# Match the learning internal-report credential.
# LEARNING_SERVICE_TOKEN=
# A NEW exclusive database, distinct from learning and simulation tests.
SQ_PEOPLE_TEST_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/stockquest_test_people
SQ_PEOPLE_TEST_DB_USER=stockquest_people_test
SQ_PEOPLE_TEST_DB_PASSWORD=replace-with-test-password
