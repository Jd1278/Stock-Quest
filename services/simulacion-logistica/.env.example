# Reference only: Spring Boot does not load this file automatically. Set session environment variables.
SIMULATION_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/stockquest_simulation_dev
SIMULATION_DB_USER=stockquest_simulation
SIMULATION_DB_PASSWORD=replace-with-local-password
SIMULATION_PORT=4010
IDENTITY_ME_URL=http://127.0.0.1:4000/api/auth/me
# Match the backend token for private summary/administrative reads (minimum 32 characters).
# SIMULATION_SERVICE_TOKEN=
# Enable only when the backend is in java mode and its inbox migration has been applied.
SIMULATION_EVENTS_ENABLED=false
SIMULATION_EVENTS_TARGET=http://127.0.0.1:4000/internal/events
# SIMULATION_EVENT_TOKEN=
# Separate, empty database exclusively for personally executed integration tests:
SQ_TEST_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/stockquest_test_simulation
SQ_TEST_DB_USER=stockquest_simulation_test
SQ_TEST_DB_PASSWORD=replace-with-test-password
