# Reference only: Spring does not automatically read this file.
LEARNING_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/stockquest_learning_dev
LEARNING_DB_USER=stockquest_learning
LEARNING_DB_PASSWORD=replace-with-local-password
LEARNING_PORT=4020
IDENTITY_ME_URL=http://127.0.0.1:4000/api/auth/me
# Match the edge token; independent of the simulation service token.
# LEARNING_SERVICE_TOKEN=
SIMULATION_SERVICE_URL=http://127.0.0.1:4010
# SIMULATION_SERVICE_TOKEN=
# Match the simulation producer and the Express event bridge.
# SIMULATION_EVENT_TOKEN=
# A NEW, exclusive learning test database; never reuse simulation/backend databases.
SQ_LEARNING_TEST_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/stockquest_test_learning
SQ_LEARNING_TEST_DB_USER=stockquest_learning_test
SQ_LEARNING_TEST_DB_PASSWORD=replace-with-test-password
